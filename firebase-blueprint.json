{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "wpmRecord": { "type": "number" },
        "gamesPlayed": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["displayName", "wpmRecord", "gamesPlayed", "createdAt", "updatedAt"]
    },
    "Score": {
      "title": "Score",
      "description": "Individual typing test score",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "wpm": { "type": "number" },
        "accuracy": { "type": "number" },
        "mode": { "type": "string", "enum": ["practice", "race"] },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "wpm", "accuracy", "mode", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles."
    },
    "/scores/{scoreId}": {
      "schema": { "$ref": "#/entities/Score" },
      "description": "Stores individual typing scores for leaderboards."
    }
  }
}
