rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'wpmRecord', 'gamesPlayed', 'createdAt', 'updatedAt'])
        && data.keys().size() == 5
        && data.displayName is string
        && data.displayName.size() > 0 && data.displayName.size() <= 64
        && data.wpmRecord is number
        && data.gamesPlayed is number
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      // Leaderboards require public read
      allow read: if true;
      allow create: if isSignedIn() 
        && isValidId(userId)
        && request.auth.uid == userId 
        && isValidUser(incoming());
      allow update: if isSignedIn() 
        && isValidId(userId)
        && request.auth.uid == userId 
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'wpmRecord', 'gamesPlayed', 'updatedAt'])
        && incoming().displayName is string && incoming().displayName.size() > 0 && incoming().displayName.size() <= 64
        && incoming().wpmRecord is number
        && incoming().gamesPlayed is number
        && incoming().updatedAt == request.time
        && incoming().createdAt == existing().createdAt;
    }

    function isValidScore(data) {
      return data.keys().hasAll(['userId', 'wpm', 'accuracy', 'mode', 'createdAt'])
        && data.keys().size() == 5
        && data.userId == request.auth.uid
        && data.wpm is number
        && data.accuracy is number
        && data.mode is string && data.mode in ['practice', 'race']
        && data.createdAt == request.time;
    }

    match /scores/{scoreId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(scoreId) && isValidScore(incoming());
      allow update, delete: if false; // scores are immutable
    }
    
    // Global lock for any undefined collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
